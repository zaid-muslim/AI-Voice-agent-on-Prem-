cat <<EOF > .gitignore
# Virtual environments
vllm_venv/
.venv/
env/
venv/

# Python caches and compiles
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Local configuration and environment variables
.env
.env.local

# OS generated files
.DS_Store
Thumbs.db

# Audio / model caches if any
*.wav
*.mp3
*.bin
*.pt
*.safetensors
EOF
