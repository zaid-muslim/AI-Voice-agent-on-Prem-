# Copy to .env and fill in for your machine. .env itself is gitignored -
# never commit real passwords or LAN IPs.

# ---- LiveKit (defaults match `livekit-server --dev` exactly) --------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# What the BROWSER dials (token_server hands this to the page). For phone
# testing on LAN this MUST be your machine's LAN IP, not localhost:
LIVEKIT_WS_URL=ws://<this-machine-LAN-IP>:7880

# ---- LLM: your existing vLLM server -----------------------------------
# Which model is actually served is controlled by system_config.json (edit
# via the dev console at :7871, or hand-edit that file), NOT an env var
# here - VLLM_BASE_URL only tells the agent WHERE to find vLLM.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
MAX_TOKENS=300

# ---- STT: which engine is active is controlled by system_config.json --
# Shared faster-whisper STT service (stt_service/server.py) - the default
# engine. Same machine by default; point at a dedicated STT box's LAN IP
# if you ever split it out like the Qwen-Omni TTS box below.
SHARED_STT_BASE_URL=http://localhost:8020
WHISPER_MODEL=distil-large-v3
VAD_MIN_SILENCE=0.4

# ---- STT (candidate): NVIDIA Parakeet / Canary - own isolated venv -----
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v2
PARAKEET_PYTHON=/path/to/.venv-parakeet/bin/python
PARAKEET_WORKER=/path/to/app/plugins/parakeet_worker.py
CANARY_PYTHON=/path/to/.venv-parakeet/bin/python
CANARY_WORKER=/path/to/app/plugins/canary_worker.py

# ---- TTS: Qwen3-TTS via vLLM-Omni on PC2 (the default) -----------------
QWEN_OMNI_BASE_URL=http://<PC2-LAN-IP>:8091/v1
QWEN_OMNI_MODEL=/path/to/models/qwen3-tts/Qwen3-TTS-12Hz-1.7B-CustomVoice
QWEN_OMNI_VOICE=Aiden

# ---- TTS (legacy fallback): local Qwen subprocess ----------------------
QWEN_PYTHON=/path/to/.venv-voice/bin/python
QWEN_WORKER=/path/to/app/plugins/workers/qwen_worker.py
QWEN_MODEL_ID=/path/to/models/Qwen3-TTS-0.6B-custom
QWEN_SPEAKER=aiden
QWEN_LANGUAGE=English

# ---- TTS (candidate): Chatterbox / Kokoro / Piper - own isolated venvs -
CHATTERBOX_PYTHON=/path/to/.venv-chatterbox/bin/python
CHATTERBOX_WORKER=/path/to/app/plugins/chatterbox_worker.py
KOKORO_PYTHON=/path/to/.venv-kokoro/bin/python
KOKORO_WORKER=/path/to/app/plugins/kokoro_worker.py
# Piper is GPL-3.0-or-later - get legal sign-off before commercial use.
PIPER_PYTHON=/path/to/.venv-piper/bin/python
PIPER_WORKER=/path/to/app/plugins/piper_worker.py
PIPER_MODEL_PATH=/path/to/models/piper/en_US-lessac-medium.onnx

# ---- Admin UI (hospital data + doctor schedules) -----------------------
ADMIN_PASSWORD=change-me
ADMIN_USERNAME=admin

# ---- Dev console (model/backend switcher) ------------------------------
DEV_PASSWORD=change-me
DEV_USERNAME=dev
VLLM_PYTHON=/path/to/.vllm_venv/bin/python
