# Virtual environments (each STT/TTS candidate engine gets its own isolated
# venv - see README's "candidate engines" section for why)
venv/
env/
.venv/
.venv-*/
vllm_venv/
.vllm_venv/

# Python caches and compiles
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Model weights (large, fetched separately - see README setup steps)
models/

# Runtime data - the real hospital_bookings.db lives on disk and is
# volume-mounted into containers (see docker/docker-compose.yml), but is
# NOT committed: it's mutable, per-deployment data, not source.
*.db
*.db-wal
*.db-shm
latency_log.jsonl
tests/manual/latency_results.json

# Vendored/third-party source checked out locally but not part of this repo
# (its own git history - see remote/qwen_tts_server/README for setup)
remote_services/

# Dead/abandoned experiments kept around locally for reference
archive/

# Local configuration and secrets
.env
.env.local

# OS generated files
.DS_Store
Thumbs.db

# Audio / misc scratch output
*.wav
*.mp3
*.bin
*.pt
*.safetensors
data/
